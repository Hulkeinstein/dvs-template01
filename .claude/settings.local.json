{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(for file in app/(courses)/course-filter-*-*/[courseId]/index.js)",
      "Bash(do if [ -f \"$file\" ])",
      "Bash(then sed -i 's/}, \\[getParams.courseId\\]);/}, [checkMatchCourse, courseId, matchedCourse, router]);/' \"$file\")",
      "Bash(fi)"
    ],
    "deny": [],
    "ask": []
  },
  "enableAllProjectMcpServers": true
}
