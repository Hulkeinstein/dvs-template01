# ===============================================
# PRODUCTION ENVIRONMENT VARIABLES
# ===============================================
# Copy this file to .env.production.local for production deployment
# Never commit .env.production.local to version control

# ===============================================
# APPLICATION SETTINGS
# ===============================================
NODE_ENV=production
NEXTAUTH_URL=https://yourdomain.com
# Generate with: openssl rand -base64 64
NEXTAUTH_SECRET=<generate-new-64-char-secret-never-reuse-dev-secret>

# ===============================================
# SUPABASE CONFIGURATION (Production Project)
# ===============================================
# Create a separate production project in Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<production-anon-key>
# CRITICAL: Never expose this key to client-side code
SUPABASE_SERVICE_ROLE_KEY=<production-service-role-key>

# MCP Server Configuration (if using Claude Code in production)
SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_PAT=<production-personal-access-token>
SUPABASE_DVS_PROJECT_REF=<production-project-ref>

# ===============================================
# EMAIL SERVICE (Resend)
# ===============================================
# Production API key from resend.com
RESEND_API_KEY=re_production_xxxxx

# Single sender for MVP stage
EMAIL_FROM="DVS Education <noreply@yourdomain.com>"

# Growth stage: Separate senders by purpose (optional)
# EMAIL_FROM_TRANSACTIONAL="DVS <noreply@yourdomain.com>"
# EMAIL_FROM_MARKETING="DVS Marketing <marketing@yourdomain.com>"
# EMAIL_FROM_SYSTEM="DVS Notifications <notifications@yourdomain.com>"
# EMAIL_FROM_SUPPORT="DVS Support <support@yourdomain.com>"

# ===============================================
# GOOGLE OAUTH CONFIGURATION
# ===============================================
# Production OAuth app from Google Cloud Console
# Ensure redirect URIs match your domain
GOOGLE_CLIENT_ID=<production-client-id>
GOOGLE_CLIENT_SECRET=<production-client-secret>

# ===============================================
# ADMIN DASHBOARD (Optional)
# ===============================================
# Production admin subdomain
ADMIN_URL=https://admin.yourdomain.com
NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.com

# ===============================================
# SSO CONFIGURATION (Optional)
# ===============================================
# For cross-domain authentication
JWT_SECRET=<generate-secure-random-string-at-least-32-chars>
COOKIE_DOMAIN=.yourdomain.com

# JWT key pair for SSO (RS256)
# Generate with:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# cat private.pem | base64
# cat public.pem | base64
JWT_PRIVATE_KEY_B64=<base64-encoded-private-key>
JWT_PUBLIC_KEY_B64=<base64-encoded-public-key>

# ===============================================
# FEATURE FLAGS
# ===============================================
NEXT_PUBLIC_CERTIFICATE_ENABLED=true
PDF_ENABLED=true

# ===============================================
# PRODUCTION CHECKLIST
# ===============================================
# Before deploying to production, ensure:
# 
# 1. All values above are set with production credentials
# 2. Supabase RLS policies are enabled on all tables
# 3. Google OAuth is in production mode (not testing)
# 4. Email domain is verified with SPF/DKIM/DMARC records
# 5. SSL certificate is configured
# 6. Security headers are properly set in next.config.mjs
# 7. Rate limiting is implemented
# 8. Monitoring and error tracking are configured
# 9. Backup strategy is in place
# 10. Rollback procedure is documented
#
# Run deployment check: npm run deploy:check