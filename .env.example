# ===============================================
# ENVIRONMENT VARIABLES TEMPLATE
# ===============================================
# Copy this file to .env.local for development
# Copy this file to .env.production.local for production
# Never commit .env.local or .env.production.local to version control

# ===============================================
# SUPABASE CONFIGURATION
# ===============================================
# Get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===============================================
# GOOGLE OAUTH CONFIGURATION
# ===============================================
# Create OAuth 2.0 credentials at https://console.cloud.google.com
# Development: Use localhost:3000 as redirect URI
# Production: Use your actual domain as redirect URI
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ===============================================
# EMAIL SERVICE (Resend)
# ===============================================
# Get API key from https://resend.com
# Verify your domain for production use
RESEND_API_KEY=re_xxxxx
EMAIL_FROM="Your App <noreply@yourdomain.com>"

# ===============================================
# NEXTAUTH CONFIGURATION
# ===============================================
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Generate secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-nextauth-secret-here

# ===============================================
# MCP SERVER CONFIGURATION (Claude Code)
# ===============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PAT=your-personal-access-token
SUPABASE_DVS_PROJECT_REF=your-project-ref

# ===============================================
# PAYMENT INTEGRATION - PAYPAL
# ===============================================
# Get credentials from https://developer.paypal.com
# 1. Create REST API app in Developer Dashboard
# 2. Use Sandbox credentials for testing
# 3. Switch to Live credentials for production
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxxxx-sandbox
PAYPAL_CLIENT_SECRET=xxxxx-sandbox
PAYPAL_MODE=sandbox
ENABLE_PAYPAL=false

# ===============================================
# PAYMENT INTEGRATION - STRIPE
# ===============================================
# Get credentials from https://stripe.com/docs
# Set to true when Stripe integration is implemented
NEXT_PUBLIC_STRIPE_ENABLED=false

# ===============================================
# FEATURE FLAGS
# ===============================================
NEXT_PUBLIC_CERTIFICATE_ENABLED=false
PDF_ENABLED=false

# ===============================================
# ADMIN DASHBOARD CONFIGURATION
# ===============================================
# Development: http://localhost:3002
# Production: https://admin.yourdomain.com
ADMIN_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ===============================================
# SSO CONFIGURATION
# ===============================================
JWT_SECRET=your-jwt-secret-at-least-32-chars
COOKIE_DOMAIN=localhost

# JWT key pair for SSO (RS256)
# Generate with:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# cat private.pem | base64
# cat public.pem | base64
JWT_PRIVATE_KEY_B64=base64-encoded-private-key
JWT_PUBLIC_KEY_B64=base64-encoded-public-key

# ===============================================
# GOOGLE OAUTH SETUP GUIDE
# ===============================================
# 1. Go to https://console.cloud.google.com
# 2. Create or select a project
# 3. Enable Google+ API
# 4. Create OAuth 2.0 credentials (Web application)
# 5. Add authorized redirect URIs:
#    - Development: http://localhost:3000/api/auth/callback/google
#    - Production: https://yourdomain.com/api/auth/callback/google
# 6. Copy Client ID and Client Secret

# ===============================================
# TESTING vs PRODUCTION MODE
# ===============================================
# OAuth Consent Screen Status:
# - Testing: Only test users can login (max 100 users)
# - In production: Anyone can login
# 
# Recommendation:
# - Keep in Testing mode during development
# - Add team members as test users
# - Switch to In production just before launch

# ===============================================
# PRODUCTION DEPLOYMENT
# ===============================================
# For production deployment guide and checklist:
# - See modules/production-deployment.md
# - Copy .env.production.example for production values
# - Run scripts/deployment/deploy-checklist.sh before deploying
# 
# Security reminders:
# - Never commit .env.local or .env.production.local
# - Rotate API keys quarterly
# - Enable Supabase RLS on all tables
# - Verify email domain (SPF/DKIM/DMARC)