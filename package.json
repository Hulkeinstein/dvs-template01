    "slugify": "^1.6.6",
    "swiper": "^11.0.5",
    "tailwind-merge": "^3.3.1",
    "twilio": "^5.7.3",
    "typed.js": "^2.1.0",
    "use-debounce": "^10.0.5",
    "venobox": "^2.1.3",
    "wowjs": "^1.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@types/recharts": "^1.8.29",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.0",
    "dunder-proto": "^1.0.0",
    "eslint": "8.57.0",
    "eslint-config-next": "^15.4.5",
    "husky": "^9.1.7",
    "import-fresh": "^3.3.1",
    "jest": "^30.0.5",
    "jest-environment-jsdom": "^30.0.5",
    "lint-staged": "^16.1.4",
    "postcss": "^8.5.6",
    "prettier": "3.5.3",
    "shadcn": "^3.0.0",
    "styled-jsx": "^5.1.6",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
