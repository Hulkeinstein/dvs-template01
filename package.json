{
  "name": "histudy-nextjs-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11 <21"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "npx prettier@3.5.3 --write .",
    "format:check": "npx prettier@3.5.3 --check .",
    "type-check": "tsc --noEmit",
    "test": "NODE_ENV=test jest --detectOpenHandles",
    "test:watch": "NODE_ENV=test jest --watch --detectOpenHandles",
    "test:coverage": "NODE_ENV=test jest --coverage --detectOpenHandles",
    "test:ci": "NODE_ENV=test jest --ci --runInBand --coverage --detectOpenHandles",
    "ci:check": "npm run type-check && npm run lint && npm run format:check && npm run test:ci",
    "prepare": "husky",
    "pre-commit": "tsx scripts/automation/pre-commit-checks.ts",
    "automation:test": "tsx scripts/automation/test-automation.ts",
    "pr:create": "tsx scripts/automation/gh-pr-helper.ts create",
    "pr:merge": "tsx scripts/automation/gh-pr-helper.ts merge",
    "pr:help": "tsx scripts/automation/gh-pr-helper.ts",
    "quality:check": "npm run lint && npm run type-check",
    "quality:pre-push": "tsx scripts/guards/pre-push.ts",
    "security:scan": "node scripts/automation/security-scan.js",
    "git:setup": "husky && echo 'Git hooks setup complete'",
    "git:workflow": "node scripts/automation/git-workflow-helper.js",
    "git:enable-auto-push": "node -e \"const fs=require('fs');const cfg='.git-workflow.json';const c=JSON.parse(fs.readFileSync(cfg));c.autoPush=true;fs.writeFileSync(cfg,JSON.stringify(c,null,2))\" && echo 'Auto-push enabled'",
    "git:disable-auto-push": "node -e \"const fs=require('fs');const cfg='.git-workflow.json';const c=JSON.parse(fs.readFileSync(cfg));c.autoPush=false;fs.writeFileSync(cfg,JSON.stringify(c,null,2))\" && echo 'Auto-push disabled'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.0",
    "@supabase/mcp-server-supabase": "^0.4.5",
    "@supabase/supabase-js": "^2.50.0",
    "@tanstack/react-table": "^8.21.3",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bootstrap": "^5.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^11.0.8",
    "gray-matter": "^4.0.3",
    "jodit-react": "^5.2.19",
    "jose": "^6.1.0",
    "lucide-react": "^0.542.0",
    "luxon": "^3.4.4",
    "next": "^14.2.31",
    "next-auth": "^4.24.11",
    "next-mdx-remote": "^4.4.1",
    "plyr": "^3.7.8",
    "rc-slider": "^10.5.0",
    "react": "^18.3.1",
    "react-circular-progressbar": "^2.1.0",
    "react-countup": "^6.5.3",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-icons": "^4.11.0",
    "react-intersection-observer": "^9.5.3",
    "react-odometerjs": "^3.1.0",
    "react-phone-input-2": "^2.15.1",
    "react-quill": "^2.0.0",
    "react-redux": "^8.0.5",
    "react-scroll": "^1.9.0",
    "react-scroll-parallax": "^3.4.5",
    "react-select": "^5.8.0",
    "recharts": "^2.15.4",
    "redux": "^4.2.0",
